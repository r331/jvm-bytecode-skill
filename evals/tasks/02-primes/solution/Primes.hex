# Primes.class - hand-written, major 65 (Java 21), StackMapTable required.
#
# java Primes <n>: prints all primes <= n on one line, separated by single spaces
# (empty line if none). n must be an integer 0..100000.
#
# Design (pseudocode):
#   static void main(String[] args)           ([Ljava/lang/String;)V, flags 0009
#     locals: 0 = args, 1 = n (int), 2 = sb (StringBuilder), 3 = i (int), 4 = j (int)
#     if args.length != 1 -> err("Usage: java Primes <n>")
#     try { n = Integer.parseInt(args[0]) } catch NumberFormatException -> err(RANGE)
#     if n < 0 || n > 100000 -> err(RANGE)
#     sb = new StringBuilder(); i = 2
#     loop_i: while i <= n:
#       j = 2
#       loop_j: while j*j <= i:
#         if i % j == 0 -> next_i
#         j++
#       prime: if sb.length() != 0: sb.append(' ')
#       app:   sb.append(i)
#       next_i: i++
#     System.out.println(sb.toString()); return
#     err: [String] System.err.println(msg); System.exit(1); return
#   RANGE = "Error: n must be an integer between 0 and 100000"

