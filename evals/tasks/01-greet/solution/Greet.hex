# Everything after '#' on a line is a comment; the rest is raw bytes.
#
# Behavior:
#   java Greet          -> stdout "Hello, World!\n", exit 0
#   java Greet <name>   -> stdout "Hello, <name>!\n", exit 0
#   java Greet a b ...  -> stderr "Usage: java Greet [name]\n", exit 1
#
# Pseudocode for main([Ljava/lang/String;)V (static, locals: 0 args, 1 n, 2 name):
#   n = args.length
#   if (n > 1) { System.err.println("Usage: java Greet [name]"); System.exit(1); return; }
#   name = "World"
#   if (n != 0) name = args[0]
#   System.out.println(new StringBuilder().append("Hello, ").append(name).append("!").toString())
#
# Major 49: verified by type inference, so no StackMapTable is needed.

