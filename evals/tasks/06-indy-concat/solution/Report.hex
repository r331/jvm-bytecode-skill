# Report.class - hand-written reference solution, major 65 (Java 21)
#
# All string building uses invokedynamic call sites bootstrapped by
# java/lang/invoke/StringConcatFactory.makeConcatWithConstants; each recipe is a
# String constant where byte 01 (\u0001) marks one dynamic argument.
#
# Pseudocode for main([Ljava/lang/String;)V, static:
#   locals: 0 args, 1 count (I), 2 vals ([I), 3 i (I), 4-5 sum (J), 6 min (I), 7 max (I),
#           8 arg (String; later reused for the Values line string s), 9 v (I)
#   if (args.length == 0) { msg = USAGE; goto err }
#   count = args.length - 1; if (count == 0) { msg = NOVALUES; goto err }
#   vals = new int[count]; sum = 0L; min = Integer.MAX_VALUE; max = Integer.MIN_VALUE
#   for (i = 0; i < count; i++) {
#     arg = args[i + 1]
#     try { v = Integer.parseInt(arg) } catch (NumberFormatException) { goto bad }
#     vals[i] = v; sum += (long) v
#     if (v < min) min = v
#     if (v > max) max = v
#   }
#   out.println(indy#0 "Report for \1: count=\1, sum=\1, min=\1, max=\1, avg=\1"
#                       (args[0], count, sum, min, max, (double) sum / (double) count))
#   s = indy#1 "Values: [\1" (vals[0])
#   for (i = 1; i < count; i++) s = indy#2 "\1, \1" (s, vals[i])
#   out.println(indy#3 "\1]" (s)); return
#   bad: msg = indy#4 "Error: invalid int: \1" (arg)    (falls through to err)
#   err: stack [String msg]: err.println(msg); System.exit(1); return

