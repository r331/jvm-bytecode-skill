# Calc.class - hand-written reference solution, major 61 (Java 17)
#
# Pseudocode for main([Ljava/lang/String;)V, static:
#   locals: 0 = args (String[]), 1-2 = a (long), 3-4 = b (long), 5 = op (String)
#   if (args.length != 3) { code = 1; msg = USAGE; goto err }
#   try { a = Long.parseLong(args[0]); b = Long.parseLong(args[2]) }
#   catch (NumberFormatException) { code = 1; msg = INVALID; goto err }
#   op = args[1]
#   if (op.length() != 1) goto unknown
#   lookupswitch (op.charAt(0)) {
#     '%' -> rem   '+' -> add   '-' -> sub   '/' -> div   'x' -> mul   default -> unknown }
#   add: push a + b; goto print      sub: push a - b; goto print     mul: push a * b; goto print
#   div: if (b == 0) goto divz; push a / b; goto print
#   rem: if (b == 0) goto divz; push a % b; goto print
#   print: System.out.println(long on stack); return
#   divz: code = 3; msg = DIVZERO; goto err
#   unknown: code = 2; System.err.print(UNKNOWN_PREFIX); msg = op; (fall through to err)
#   err: stack [int code, String msg]: System.err.println(msg); System.exit(code); return
#
# ldiv of Long.MIN_VALUE by -1 overflows to Long.MIN_VALUE without an exception (JVMS ldiv);
# lrem of Long.MIN_VALUE by -1 is 0.

