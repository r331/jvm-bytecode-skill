# Inventory.class - PATCHED reference solution, major 65 (Java 21).
# Derived from ../original/Inventory.hex (the legacy class) with the three fixes below;
# everything else (pool order, members, line numbers, attributes) is unchanged.
#
# It imitates javac output: default constructor, ConstantValue on a static final,
# a static field table set up in <clinit>, LineNumberTable in every method,
# StackMapTable, an exception table, and a SourceFile attribute.
#
# Pseudo source (line numbers match the LineNumberTable entries):
#  1 public class Inventory {
#  2   static final int CAPACITY = 8;
#  3   static String[] names = new String[CAPACITY];
#  4   static int[] qtys = new int[CAPACITY];
#  5   static int count;
#  7   main(args):                                    locals 0 args, 1 i, 2 cmd, 3 name, 4 q
#  8     if (args.length == 0)
#  9       fail("Usage: java Inventory <command>...", 1);
# 11     i = 0;
# 12     while (i < args.length) {
# 13       cmd = args[i];
# 14       if (cmd.equals("add") || cmd.equals("remove")) {
# 15         if (i + 2 >= args.length)
# 16           fail("Error: missing argument for ".concat(cmd), 2);
# 18         name = args[i + 1];
# 19         q = parseQty(args[i + 2]);
# 20         if (cmd.equals("add"))
# 21           add(name, q);
# 23         else remove(name, q);
# 25         i += 3;
# 26       } else if (cmd.equals("total")) {
# 27         System.out.println(total());
# 28         i++;
# 29       } else if (cmd.equals("list")) {
# 30         list();
# 31         i++;
# 33       } else fail("Error: unknown command ".concat(cmd), 2);
# 36   }
# 38   find(name): for (i = 0; i < count; i++) if (names[i].equals(name)) return i; return -1;
# 47   parseQty(s): try { q = Integer.parseInt(s); } catch (NumberFormatException e) { q = 0; }
# 54                if (q <= 0) fail("Error: invalid quantity ".concat(s), 3); return q;
# 60   add(name, q): i = find(name); if (i >= 0) { qtys[i] += q; return; }
# 66                 if (count == CAPACITY) fail("Error: inventory full", 5);
# 69                 names[count] = name; qtys[count] = q; count++;
# 74   remove(name, q): i = find(name); if (i < 0) fail("Error: unknown item ".concat(name), 4);
# 79                    if (qtys[i] < q) fail("Error: insufficient stock for ".concat(name), 4);
# 82                    qtys[i] -= q;
# 85   total(): sum = 0; for (i = 0; i < count; i++) sum += qtys[i]; return sum;
# 93   list(): for (i = 0; i < count; i++) { out.print(names[i]); out.print('='); out.println(qtys[i]); }
#101   fail(msg, code): System.err.println(msg); System.exit(code);
#105 }
#
# FIXES applied to the legacy class:
#  (a) list(): removed the iconst_1/isub after getstatic count (bound is now count, not count - 1).
#      The code shrinks by 2 bytes: code_length 48 -> 46, Code length 107 -> 105, goto -42 -> -40,
#      later LineNumberTable pcs -2, and the chop frame delta 44 -> 42 (@47 -> @45).
#  (b) parseQty(): ifne (9A) -> ifgt (9D), so q <= 0 (including negatives) is rejected.
#  (c) remove(): new pool entries #117 Utf8 "Error: unknown item " and #118 String,
#      constant_pool_count 117 -> 119, and the unknown-item ldc now loads #118 instead of #112.

