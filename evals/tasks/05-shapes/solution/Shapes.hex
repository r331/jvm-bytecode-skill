# Shapes.class - hand-written, major 55 (Java 11)
#
# Pseudocode for main([Ljava/lang/String;)V, static:
#   locals: 0 = args (String[]), 1 = n then count (int), 2 = shapes (Shape[]), 3 = i (int),
#           4 = kind (String), 5 = code (int, 1 circle / 2 square), 6 = sizeArg (String),
#           7-8 = size (double); in the print phase 4-5 = total (double), 6 = s (Shape),
#           7-8 = a (double)
#   n = args.length
#   if (n == 0 || (n & 1) != 0) goto usage
#   count = n >> 1; shapes = new Shape[count]; i = 0
#   L1: if (i >= count) goto print
#     kind = args[i << 1]
#     code = 1; if (kind.equals("circle")) goto parse
#     code = 2; if (kind.equals("square")) goto parse
#     System.err.print("Unknown shape: "); System.err.println(kind); System.exit(2); return
#   parse: sizeArg = args[(i << 1) + 1]
#     try { size = Double.parseDouble(sizeArg) } catch (NumberFormatException) { goto invalid }
#     if (!(size > 0)) goto invalid            (dcmpl + ifle: NaN is invalid)
#     shapes[i] = code == 1 ? new Circle(size) : new Square(size)
#     i++; goto L1
#   print: total = 0.0; i = 0
#   L2: if (i >= count) goto end
#     s = shapes[i]
#     System.out.print(s.name()); System.out.print(' ')     (invokeinterface Shape.name)
#     a = s.area(); System.out.println(a); total += a        (invokeinterface Shape.area)
#     i++; goto L2
#   end: System.out.print("total "); System.out.println(total); return
#   invalid: System.err.print("Invalid size: "); System.err.println(sizeArg); System.exit(1); return
#   usage: System.err.println(USAGE); System.exit(1); return

