# Rpn.class - hand-written reference solution, major 65 (Java 21)
#
# java Rpn "<expr>": Reverse Polish Notation calculator over doubles.
#
# Pseudocode (all methods static):
#
# main([Ljava/lang/String;)V
#   locals: 0 args, 1 s (String), 2 st (double[64]), 3 sp (int), 4 n (int), 5 i (int), 6 j (int)
#   if (args.length != 1) { fail(USAGE, ""); return }
#   s = args[0]; st = new double[64]; sp = 0; n = s.length(); i = 0
#   loop: while (i < n) {
#     if (s.charAt(i) == ' ') { i++; continue }
#     j = i; while (j < n && s.charAt(j) != ' ') j++
#     sp = apply(st, sp, s.substring(i, j)); i = j }
#   if (sp != 1) { fail(EXPECTED, String.valueOf(sp)); return }
#   System.out.println(st[0])                         (println(D) prints String.valueOf(double))
#
# apply([DILjava/lang/String;)I  -> new stack depth
#   locals: 0 st, 1 sp, 2 tok, 3 c (int), 4-5 v (double)
#   c = tok.charAt(0)                                 (tokens are never empty)
#   if (tok.length() == 1) lookupswitch (c) { '*' '+' '-' '/' '^' -> BIN; default -> WORDS }
#   BIN:   if (sp < 2) UNDER; st[sp-2] = binop(c, st[sp-2], st[sp-1]); return sp - 1
#   WORDS: "sqrt" -> SQRT, "neg" -> NEG, "dup" -> DUP, "swap" -> SWAP
#          if c is '-' or '.' or '0'..'9' -> NUM else UNK
#   NUM:   v = toNumber(tok) (exits on invalid); if (sp >= 64) OVER; st[sp] = v; return sp + 1
#   UNK:   fail(UNKNOWN, tok)
#   SQRT:  if (sp <= 0) UNDER; st[sp-1] = Math.sqrt(st[sp-1]); return sp
#   NEG:   if (sp <= 0) UNDER; st[sp-1] = -st[sp-1]; return sp
#   DUP:   if (sp <= 0) UNDER; if (sp >= 64) OVER; st[sp] = st[sp-1]; return sp + 1
#   SWAP:  if (sp < 2) UNDER; v = st[sp-1]; st[sp-1] = st[sp-2]; st[sp-2] = v; return sp
#   UNDER: fail(UNDERFLOW, "")        OVER: fail(OVERFLOW, "")
#   (after each fail: iconst_0; ireturn, never reached because fail exits)
#
# toNumber(Ljava/lang/String;)D   grammar: -?[0-9]+(\.[0-9]+)?
#   locals: 0 s, 1 n, 2 i, 3 neg, 4-5 m (double), 6-7 p (double), 8 start, 9 d
#   n = s.length(); i = 0; neg = 0
#   if (s.charAt(0) == '-') { neg = 1; i = 1 }
#   m = 0.0; p = 1.0; start = i
#   while (i < n && (d = s.charAt(i) - '0') in 0..9) { m = m * 10.0 + d; i++ }
#   if (i == start) BAD
#   if (i < n) {
#     if (s.charAt(i) != '.') BAD
#     i++; start = i
#     while (i < n && (d = s.charAt(i) - '0') in 0..9) { m = m * 10.0 + d; p = p * 10.0; i++ }
#     if (i == start) BAD
#     if (i < n) BAD }
#   DONE: m = m / p; if (neg) m = -m (dneg, so "-0" gives -0.0); return m
#   BAD: fail(INVALID, s)
#
# binop(IDD)D: lookupswitch (c) { '*' a*b  '+' a+b  '-' a-b  '/' a/b  '^' and default Math.pow(a,b) }
#
# fail(Ljava/lang/String;Ljava/lang/String;)V: System.err.print(a); System.err.println(b); System.exit(1)

