# Steps.class - hand-written reference solution, major 65 (Java 21)
#
# main([Ljava/lang/String;)V, public static, locals: 0 = args
#   if (args.length == 0) { System.err.println(USAGE); System.exit(1); return }
#   run(args); return
#
# run([Ljava/lang/String;)V, private static
#   locals: 0 = steps (String[]), 1 = i (int, 1-based step number), 2 = s (String),
#           3 = inner caught exception (ISE in the catch, Throwable in the finally handler)
#   In the outer handlers slot 1 is reused for the caught exception (i is out of scope).
#
#   i = 1
#   OUTER TRY {
#     loop: if (i > steps.length) goto loopEnd
#       INNER TRY {
#         s = steps[i - 1]
#         if s.equals("ok")   -> printOk
#         if s.equals("fail") -> throw new IllegalStateException("step " + i + " failed")
#         if s.equals("npe")  -> ((String) null).length()       (real NullPointerException)
#         if s.equals("div")  -> i / 0                          (ArithmeticException)
#         if s.equals("exit") -> [inner finally copy] [outer finally copy] return
#                                (the two copies are excluded from the ranges of the
#                                 handlers whose finally they inline, like javac does)
#         throw new IllegalArgumentException("unknown step: " + s)
#         printOk: println("step " + i + " ok")
#       } -> [inner finally copy] goto next
#       catch (IllegalStateException e) { println("caught: " + e.getMessage()) } -> [inner finally copy] goto next
#       any (Throwable t) { [inner finally copy] throw t }
#     next: i++; goto loop
#   } loopEnd: [outer finally copy] goto end
#   catch (RuntimeException e) { println("outer: " + e.getClass().getSimpleName()) } -> [outer finally copy] goto end
#   any (Throwable t) { [outer finally copy] throw t }
#   end: return
#
#   inner finally body: println("cleanup " + i)      outer finally body: println("done")

