00 05                           # name "m"
00 06                           # descriptor "()V"
00 01                           # attributes_count
00 07                           # attribute "Code"
00 00 02 4F                     # attribute_length = 591 = 12 + code_length
01 00                           # max_stack = 256 (never verified)
02 00                           # max_locals = 512 (wide indices up to 302)
00 00 02 43                     # code_length = 579

