# Opcodes.class - hand-written class file used only to check opcode decoding with javap -c.
# It is never loaded or run (the code is not type-correct and uses jsr/ret), it only has to parse.
# test-opcodes.sh reads the lines between BEGIN CODE and END CODE: the first byte of each line is
# the opcode, the comment is '<offset> <mnemonic> [note]'. It checks the opcode against
# references/instructions.md and the offset/mnemonic against javap -c output.
# Covers every assigned opcode except invokedynamic (needs BootstrapMethods) and the reserved ones.

CA FE BA BE                     # magic
00 00 00 31                     # minor 0, major 49 (jsr/ret allowed, no StackMapTable)

00 15                           # constant_pool_count = 21
01 00 07 4F 70 63 6F 64 65 73                               #  1 Utf8 "Opcodes"
07 00 01                                                    #  2 Class Opcodes
01 00 10 6A 61 76 61 2F 6C 61 6E 67 2F 4F 62 6A 65 63 74    #  3 Utf8 "java/lang/Object"
07 00 03                                                    #  4 Class java/lang/Object
01 00 01 6D                                                 #  5 Utf8 "m"
01 00 03 28 29 56                                           #  6 Utf8 "()V"
01 00 04 43 6F 64 65                                        #  7 Utf8 "Code"
01 00 01 66                                                 #  8 Utf8 "f"
01 00 01 49                                                 #  9 Utf8 "I"
0C 00 08 00 09                                              # 10 NameAndType f:I
09 00 02 00 0A                                              # 11 Fieldref Opcodes.f:I
0C 00 05 00 06                                              # 12 NameAndType m:()V
0A 00 02 00 0C                                              # 13 Methodref Opcodes.m:()V
0B 00 04 00 0C                                              # 14 InterfaceMethodref java/lang/Object.m:()V (only decoded, never resolved)
03 00 00 00 2A                                              # 15 Integer 42
05 00 00 00 00 00 00 00 07                                  # 16 Long 7 (takes indices 16 and 17)
08 00 01                                                    # 18 String #1 "Opcodes"
01 00 03 5B 5B 49                                           # 19 Utf8 "[[I"
07 00 13                                                    # 20 Class [[I

00 21                           # access: public super
00 02                           # this_class  = Opcodes
00 04                           # super_class = java/lang/Object
00 00                           # interfaces_count
00 00                           # fields_count
00 01                           # methods_count

# static void m()
